{
  "name": "athlete-os",
  "version": "0.1.0",
  "description": "Athlete OS: self-hosted WHOOP dashboard backed by local SQLite.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agabekov/athlete_os.git"
  },
  "bugs": {
    "url": "https://github.com/agabekov/athlete_os/issues"
  },
  "homepage": "https://github.com/agabekov/athlete_os#readme",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:public": "HOST=0.0.0.0 tsx watch server/index.ts",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "seed:demo": "node scripts/seed-demo.mjs"
  },
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "@hono/node-server": "^2.1.5",
    "better-sqlite3": "^12.2.0",
    "hono": "^4.13.13",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
