WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Comma-separated hostnames allowed to serve the dashboard.
# Leave empty for localhost-only. Set this on a VPS, for example:
# WHOOP_ALLOWED_HOSTS=whoop.example.com
WHOOP_ALLOWED_HOSTS=

# Optional. Defaults to data/whoop.db locally and /app/data/whoop.db in Docker.
# WHOOP_DB_PATH=data/whoop.db

# Optional listening address and port. Defaults to loopback:3000 locally.
# HOST=127.0.0.1
# PORT=3000
